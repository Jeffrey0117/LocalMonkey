# LocalMonkey 設定範例。把這份複製成 .env 就會生效：
#
#     cp .env.example .env
#     npm start
#
# `npm start` 用的是 Node 內建的 --env-file-if-exists=.env（Node 20.6+），
# 所以不需要 dotenv，零依賴這件事沒有被打破。沒有 .env 也能跑（會印一行說找不到，無害）。
# 直接 export 環境變數或寫在啟動指令前面一樣有效；真實環境變數優先於 .env 的值。

# 監聽的 port。預設 30600。
PORT=30600

# 綁定的位址。預設 127.0.0.1（只有這台機器連得到）。
#
# ⚠ 改成 0.0.0.0 等於把「管理後台」也一起開給整個區網：
#    任何人只要猜到 token 就能新增網站、寫任意 JS 注入你代理的頁面。
#    真的要給手機 / 平板用的話，請同時：
#      1. 設一把夠長的 LOCALMONKEY_ADMIN_TOKEN
#      2. 清楚知道你的 Wi-Fi 上有誰
HOST=127.0.0.1

# 後台 token。沒設的話，第一次啟動會產生一把 32 bytes 的隨機 hex，
# 寫進 data/admin-token.txt 並印在 log 裡。
# 沒有 hardcoded 預設值，也沒有「沒設就不驗證」這種模式。
LOCALMONKEY_ADMIN_TOKEN=

# 資料目錄（SQLite 檔與 token 檔放這裡）。預設是專案底下的 data/。
LOCALMONKEY_DATA_DIR=

# 放行內網目標。預設關閉：target_origin 解析到 loopback / 私網 / link-local
# 會在「新增網站時」與「每次代理請求時」被拒絕（後者是擋 DNS rebinding）。
#
# ⚠ 設成 1 之後，這支服務就能被用來打你家裡其他服務（NAS、路由器、別的 dev server）。
#    只在你要代理自己的 dev server 時才開。
LOCALMONKEY_ALLOW_PRIVATE=

# 等上游回應的逾時（毫秒）。預設 20000。
LOCALMONKEY_UPSTREAM_TIMEOUT_MS=20000

# 代理請求 body 的大小上限（bytes）。預設 26214400（25MB）。
LOCALMONKEY_MAX_BODY_BYTES=26214400

# log 等級：silent / error / warn / info / debug。預設 info。
LOCALMONKEY_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# GM_xmlhttpRequest 的伺服器端轉發（POST /__lm/gm/xhr）
#
# 這個端點會「由伺服器代替你」發請求，所以它只接受：
#   - 從 LocalMonkey 自己的代理頁面發出的請求（同源 + Referer/cookie 對得上網站）
#   - 腳本有宣告 @grant GM_xmlhttpRequest
#   - 目標主機在該腳本的 @connect 清單裡（@connect * 一律拒絕）
#   - 通過 SSRF 檢查（連轉址的每一跳都重驗）
# 轉送出去的 header 是白名單組出來的，瀏覽器的 Cookie 與後台 token 不會外流。
# ---------------------------------------------------------------------------

# 等上游回應的逾時（毫秒）。預設 30000。
LOCALMONKEY_GM_XHR_TIMEOUT_MS=30000

# 回應大小上限（bytes）。預設 10485760（10MB）。
# 上游宣告的 content-length 超過就拒絕；邊讀邊超過就截斷並標 truncated。
LOCALMONKEY_GM_XHR_MAX_BYTES=10485760

# 單次呼叫可以帶的 request body 上限（bytes，含 data）。預設 1048576（1MB）。
LOCALMONKEY_GM_XHR_MAX_REQUEST_BYTES=1048576

# 速率限制：每個代理網站在 WINDOW_MS 內最多幾次。預設 60 次 / 60 秒。
LOCALMONKEY_GM_XHR_RATE=60
LOCALMONKEY_GM_XHR_WINDOW_MS=60000

# GM_xmlhttpRequest 的「本機目標」白名單。預設空的（什麼都不放行）。
#
# 為什麼需要它：很多實用的腳本是在打你自己機器上的後端
# （例：@connect localhost + http://localhost:8001）。SSRF 防護會擋掉這種請求，
# 而且是最難除錯的那種失敗 —— 腳本看起來有跑，請求靜默失敗。
#
# 規則：
#   - 只影響 POST /__lm/gm/xhr，**不影響**代理目標（那個是 LOCALMONKEY_ALLOW_PRIVATE）
#   - 精確比對，含 port：localhost 不等於 localhost:8001，而且不做萬用字元
#   - 命中只是豁免「私網位址」那條檢查；腳本的 @connect 宣告還是要過（兩道都要過）
#   - 連 302 轉址的每一跳都重新比對
#
# ⚠ 風險講清楚：放行之後，「被你代理的那些網頁」就能透過 LocalMonkey 打到你內網的
#    這些主機（只限你列出來的 host:port，而且只有宣告過對應 @connect 的腳本能用）。
#    只列你自己的服務，不要為了方便寫一長串。
LOCALMONKEY_GM_ALLOW_HOSTS=


# ─────────────────────────── 伺服器端翻譯層（v4） ───────────────────────────
#
# 代理在 HTML 出門前，用你本機的 ollama 把文字翻成中文（預設繁體）。
# 不用 API key、不用錢、內容不會離開這台機器，而且翻一次就永久有效。
#
# 每個站預設是**關著的**（sites.translate_enabled = 0），
# 要在控制台的「網站」分頁逐站打開。沒裝 ollama 也不影響其他功能。

# ollama 的位址。
#
# ⚠ 這是**伺服器自己發起**的呼叫，不是使用者腳本發起的 —— 所以它不走 SSRF 防護，
#   也**不要**為了它去打開 LOCALMONKEY_ALLOW_PRIVATE（那是「可以代理哪些目標」的
#   全域開關，打開等於讓所有被代理的網站都能指向你的內網）。
#   跟 LOCALMONKEY_GM_ALLOW_HOSTS 也沒有關係。
LOCALMONKEY_OLLAMA_URL=http://127.0.0.1:11434

# 預設模型。每個站可以在控制台各自指定；留空就用這個。
#
# 快取的 key 含模型名稱，所以**換模型會自動重翻**，舊的譯文留著不刪
# （可以比較、也可以換回去）。
LOCALMONKEY_TRANSLATE_MODEL=qwen2.5:latest

# 一次送幾段給模型。
#
# 成本跟「那幾段有多長」成正比，不是固定的：實測 templatemo 的真實段落
# 一批 20 段約 5 秒，但如果某個站的段落特別長就要調小。
LOCALMONKEY_TRANSLATE_BATCH=20

# 叫 ollama 把模型留在記憶體多久。太短的話每隔一陣子就要再吃一次冷啟動
# （實測約 45 秒）。
LOCALMONKEY_TRANSLATE_KEEPALIVE=30m

# 每一批的逾時。冷啟動 + 一批長段落有可能逼近這個值。
LOCALMONKEY_TRANSLATE_TIMEOUT_MS=120000

# 「預先翻譯整站」時，每個請求之間至少等多久。
#
# ⚠ 這是在打**別人的**伺服器。下限就是預設值 500ms，設更小會被忽略 ——
#   這個功能不該變成壓測工具。同時也只會有 1 個請求在飛。
LOCALMONKEY_CRAWL_POLITENESS_MS=500

# 還有「做得動」的段沒翻完時，佇列隔多久自己再試一次。
#
# ⛔ 為什麼需要它：佇列存在 DB 裡，會活過重啟。沒有這個的話，
#   沒翻完的段要等到「有人剛好再載入一次頁面」才會被碰到 ——
#   使用者看到的就是「永遠差 20 段」。
#   啟動時也會自動接回上次沒翻完的（那個不受這個值影響，是立刻跑）。
LOCALMONKEY_TRANSLATE_RETRY_MS=30000

# ──────────────────────────────────────────────────────────────────────────────
# 重繪商城的金流：藍新 MPG 幕前支付（單筆買斷，SPEC-checkout）
# ──────────────────────────────────────────────────────────────────────────────
#
# 沒設 ＝ **示範模式**：購物車與訂單只存在那台瀏覽器裡，購買按鈕旁邊就寫著
# 「未接金流（示範模式）」。下面三個必填值都設了才會真的走金流。
#
# ⛔ 這幾個值**只有你自己填**。程式碼裡沒有任何預設值、沒有任何範例金鑰，
#    這份檔案也只寫鍵名不寫值。HASH_KEY / HASH_IV 一個 byte 都不會離開
#    伺服器（有測試釘著：它們不准出現在頁面、回應、log 裡）。
#    MERCHANT_ID 會出現在那張送去藍新的表單上 —— 那是幕前支付的協定本身
#    要求的（瀏覽器 POST 商店代號過去），而它不是秘密。
#
# ⛔ **已知限制：在 localhost 收不到 NotifyURL。**
#
#      ReturnURL（付完瀏覽器帶著結果跳回來）   ✅ 收得到
#      NotifyURL（藍新的伺服器主動通知）       ❌ 收不到（它打不到 127.0.0.1）
#
#    所以在這台機器上，訂單狀態完全靠「瀏覽器跳回來那一跳」確認。使用者付完
#    直接關掉瀏覽器就沒有人會來告訴我們結果，那一筆會永遠停在「還沒收到結果」。
#    **這在正式站是不夠的** —— NotifyURL 的端點已經做好
#    （/__lm/reskin/checkout/notify，驗證與結算跟 ReturnURL 共用同一套），
#    但它要能被外面打到才有用：用 tunnel 露出去或真的部署，再把
#    LOCALMONKEY_PUBLIC_URL 設成那個對外網址。在那之前這不是完整實作。

# test（預設）或 live。
#
# ⛔ live ＝ **會真的扣款**，而且購買列會顯示警告色的「正式環境（會真的扣款）」。
# ⛔ 打錯字（production 之類）**不會**靜默退回 test，而是整個當沒接金流
#    —— 金流的誤判方向只有一個是安全的。
LOCALMONKEY_NEWEBPAY_ENV=test

# 藍新的商店代號（商店後台給的 MerchantID）。
LOCALMONKEY_NEWEBPAY_MERCHANT_ID=

# 藍新的 HashKey：**正好 32 個字**（AES-256 的金鑰）。長度不對算沒接上。
LOCALMONKEY_NEWEBPAY_HASH_KEY=

# 藍新的 HashIV：**正好 16 個字**（CBC 的 iv）。長度不對算沒接上。
LOCALMONKEY_NEWEBPAY_HASH_IV=

# 回呼用的對外網址。**留空才是常態。**
#
# 空的時候回呼網址用「這個請求的 Host」組 —— 你會從 127.0.0.1、區網 IP、
# tunnel 網域進來，每一種都要回到你來的地方。
#
# ⚠ 只有一種情形要設它：**躲在反向代理後面**。那時候 Host 是內部位址，
#   後端自己組會組出 https://127.0.0.1:9501/… 這種打不開的網址。
LOCALMONKEY_PUBLIC_URL=
