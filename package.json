{
  "name": "localmonkey",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted userscript manager: reverse-proxy a site and inject your own JS, no browser extension required.",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "postinstall": "node scripts/ensure-sqlite-binding.js",
    "fix:sqlite": "node scripts/ensure-sqlite-binding.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "express": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
